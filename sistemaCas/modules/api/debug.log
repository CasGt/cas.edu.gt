, t.terceros1_retiran_alumno_telefono AS t_terceros1_retiran_alumno_telefono, t.terceros1_parentezco AS t_terceros1_parentezco, t.terceros2_retiran_alumno AS t_terceros2_retiran_alumno, t.terceros2_retiran_alumno_parentesco AS t_terceros2_retiran_alumno_parentesco, t.terceros2_retiran_alumno_telefono AS t_terceros2_retiran_alumno_telefono, t.terceros2_parentezco AS t_terceros2_parentezco
